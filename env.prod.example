# Production Environment Configuration Template
# Rename this to .env (or load as env vars) in your production environment

# ------------------------------------------------------------------------------
# CORE SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="ERP MVP Production"
DOMAIN=app.yourdomain.com

# ------------------------------------------------------------------------------
# SECURITY (CRITICAL)
# ------------------------------------------------------------------------------
# Must be generated securely (e.g. `openssl rand -hex 32`) & kept secret!
SECRET_KEY=change_me_to_a_very_long_random_string_in_production

# List of allowed hosts for TrustedHostMiddleware
# Prevents Host Header attacks. Must include your domain.
ALLOWED_HOSTS=["app.yourdomain.com","your-load-balancer-ip"]

# Strict CORS: Only allow your frontend domain
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com"]
# Optional: Regex for subdomains (e.g., https://tenant1.yourdomain.com)
# BACKEND_CORS_ORIGIN_REGEX="^https:\/\/.*\.yourdomain\.com$"

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=app_user
POSTGRES_PASSWORD=strong_db_password
POSTGRES_HOST=db_host_or_ip
POSTGRES_PORT=5432
POSTGRES_DB=erp_prod

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
PORT=8000
